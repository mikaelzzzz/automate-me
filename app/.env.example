# Copy to .env for local development. Never commit real values.

# Gemini (Google AI Studio key) — or use Vertex AI via GOOGLE_GENAI_USE_VERTEXAI
GOOGLE_API_KEY=

# Vertex AI alternative
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Google Maps Platform (Routes + Weather) — key restricted to those two APIs,
# lives in Secret Manager (maps-api-key) on Cloud Run. Empty = briefing disabled.
MAPS_API_KEY=

# Firestore
FIRESTORE_PROJECT=

# Merchant AP2 rail. MERCHANT_AUTH=idtoken attaches a Google-signed ID token
# (Cloud Run only — leave empty locally).
MERCHANT_URL=http://localhost:8081
MERCHANT_AUTH=

# Pinned model (hackathon rule: Gemini 3.5+)
GEMINI_MODEL=gemini-3.5-flash

# Demo resilience: boots seeded data, no external OAuth required
DEMO_MODE=seed

# Serve built SPA from this dir (empty = API only)
WEB_DIST=web/dist

PORT=8080
