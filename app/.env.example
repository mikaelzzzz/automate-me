# Copy to .env for local development. Never commit real values.

# Gemini (Google AI Studio key) — or use Vertex AI via GOOGLE_GENAI_USE_VERTEXAI
GOOGLE_API_KEY=

# Vertex AI alternative
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Google Maps Platform (Routes + Weather) — existing key from DWS Pro project
MAPS_API_KEY=

# Firestore
FIRESTORE_PROJECT=

# Merchant A2A endpoint
MERCHANT_URL=http://localhost:8081

# Demo resilience: boots seeded data, no external OAuth required
DEMO_MODE=seed

# Serve built SPA from this dir (empty = API only)
WEB_DIST=web/dist

PORT=8080
